# All operational defaults. Copy to .env; no shell export needed.
WHATSAPP_GROUP="Test"
MAX_PLAYERS=20
# Minimum enrollment at the registration deadline; otherwise the quiz is cancelled.
NB_PLAYERS_EXPECTED=1
MAX_QUESTIONS=30
REGISTRATION_SECONDS=60
QUESTION_SECONDS=30
INTERVAL_SECONDS=10
POLL_SECONDS=1
JOIN_COMMAND="!join"
ANSWER_PREFIX="!r"
IGNORE_ACCENTS=true
MAX_POINTS=100
MIN_POINTS=20
MAX_HISTORY_PAGES=1000
MESSAGE_CHUNK_SIZE=3000
PORT=8765

WHATSAPP_DATABASE="~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite"
